cat > .gitignore << 'EOF'
# ============================================
# Datos crudos y procesados (nunca a Git)
# ============================================
data/raw/
data/processed/
data/dictionaries
data/others
/docs-ia
*.zip
*.rar
*.7z

# Temp files
tmp_db_check.py
__pycache__/
# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv/
venv/
ENV/
env/
*.egg-info/
dist/
build/

# ============================================
# Jupyter
# ============================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================
# Logs
# ============================================
etl/logs/*.log
*.log

# ============================================
# OS / Editores
# ============================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# Parquet grandes (si los generas en raíz)
# ============================================
*.parquet
EOF
